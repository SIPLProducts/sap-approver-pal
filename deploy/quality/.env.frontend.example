# ---------------------------------------------------------------------------
# App BUILD-TIME env — QUALITY
# Copy to /data/webapplication/resl_approval/Quality/frontend/.env.build
# VITE_* values are compiled into the browser bundle: PUBLIC, and a change
# requires a full rebuild. Never put a secret here.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://api-quality.example.com
VITE_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_ANON_KEY
VITE_SUPABASE_PROJECT_ID=resl-quality
