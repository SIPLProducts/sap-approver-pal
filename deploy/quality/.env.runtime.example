# ---------------------------------------------------------------------------
# App RUNTIME env — QUALITY (server-side only, never bundled)
# Copy to /data/webapplication/resl_approval/Quality/frontend/.env.runtime
# chmod 600
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

SUPABASE_URL=https://api-quality.example.com
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_ANON_KEY
SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY

# Bypasses RLS. Never prefix with VITE_. Never log.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY

# Same value as the middleware's MIDDLEWARE_SHARED_SECRET.
MIDDLEWARE_SHARED_SECRET=CHANGE_ME_openssl_rand_hex_32

# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com
