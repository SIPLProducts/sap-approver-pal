# ---------------------------------------------------------------------------
# SAP middleware — QUALITY
# Copy to /data/webapplication/resl_approval/Quality/backend/.env  (chmod 600)
# ---------------------------------------------------------------------------

PORT=3005

# Must match MIDDLEWARE_SHARED_SECRET in the app's .env.runtime AND the
# Proxy Secret in Admin -> SAP API Settings -> Middleware Configuration.
MIDDLEWARE_SHARED_SECRET=CHANGE_ME_openssl_rand_hex_32

# The app's public URL. The middleware calls back for API config and sync logs.
APP_BASE_URL=https://quality.example.com

# 1 = offline smoke test (uses SAP_BP_* only, no callback to the app)
MIDDLEWARE_MOCK=0

# ---- Timeouts (ms). Nginx proxy_read_timeout must be >= SAP_REQUEST_TIMEOUT_MS
SAP_REQUEST_TIMEOUT_MS=300000
SAP_CONNECT_TIMEOUT_MS=60000
SAP_HEADERS_TIMEOUT_MS=60000
SAP_BODY_TIMEOUT_MS=60000

# ---- Optional fallbacks; per-row values in SAP API Settings take priority ----
SAP_BP_API_URL=
SAP_DMS_API_URL=
SAP_BP_USERNAME=
SAP_BP_PASSWORD=
