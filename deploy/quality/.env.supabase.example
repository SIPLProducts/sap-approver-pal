# ---------------------------------------------------------------------------
# Supabase self-hosted stack — QUALITY
# Copy to /data/webapplication/resl_approval/Quality/supabase/.env  (chmod 600)
# Generate every secret yourself. See docs/deployment/05-supabase.md
# ---------------------------------------------------------------------------

############ Secrets ############
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ANON_KEY=CHANGE_ME_minted_jwt_role_anon
SERVICE_ROLE_KEY=CHANGE_ME_minted_jwt_role_service_role
SECRET_KEY_BASE=CHANGE_ME_openssl_rand_hex_32
VAULT_ENC_KEY=CHANGE_ME_openssl_rand_hex_16
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME_openssl_rand_hex_32
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGE_ME_openssl_rand_hex_32

############ Studio login ############
DASHBOARD_USERNAME=studioadmin
DASHBOARD_PASSWORD=CHANGE_ME_openssl_rand_hex_24
STUDIO_DEFAULT_ORGANIZATION=RESL
STUDIO_DEFAULT_PROJECT=RESL Approvals Quality

############ Database ############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############ Host ports (QUALITY) ############
POSTGRES_PORT_EXT=5432
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3001
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=200
POOLER_TENANT_ID=resl-quality
POOLER_DB_POOL_SIZE=5

############ Public URLs — must match Nginx server_name ############
SITE_URL=https://quality.example.com
API_EXTERNAL_URL=https://api-quality.example.com
SUPABASE_PUBLIC_URL=https://api-quality.example.com
ADDITIONAL_REDIRECT_URLS=https://quality.example.com/**

############ Auth policy ############
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
JWT_EXPIRY=3600

############ SMTP ############
SMTP_ADMIN_EMAIL=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SENDER_NAME=RESL Approvals (Quality)
MAILER_URLPATHS_INVITE=/login
MAILER_URLPATHS_CONFIRMATION=/login
MAILER_URLPATHS_RECOVERY=/login
MAILER_URLPATHS_EMAIL_CHANGE=/login

############ Storage ############
FILE_SIZE_LIMIT=52428800
STORAGE_BACKEND=file
GLOBAL_S3_BUCKET=stub
REGION=stub

############ Misc ############
PGRST_DB_SCHEMAS=public,storage,graphql_public
FUNCTIONS_VERIFY_JWT=true
IMGPROXY_ENABLE_WEBP_DETECTION=true
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
