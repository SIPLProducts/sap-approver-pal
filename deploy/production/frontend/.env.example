# ---------------------------------------------------------------------------
# PRODUCTION frontend / app-server environment.
# Copy to /data/webapplication/resl_approval/Production/frontend/.env (chmod 600)
#
# Two halves, both required:
#   VITE_*  are COMPILED INTO the browser bundle at BUILD time. Missing values
#           make the app show "Missing Supabase environment variable(s)" and no
#           server-side edit can fix an already-built dist/ — you must rebuild.
#   plain   names are read at RUNTIME by the app server (dist/start.mjs).
#
# Port map (Production): nginx 9091 | SSR 8090 | Kong 8010/8453 | mw 3010 | studio 3100
# ---------------------------------------------------------------------------

PORT=8090
HOST=127.0.0.1
NODE_ENV=production

# ---- Supabase (self-hosted Production stack, Kong on :8010) ---------------
# Must be the host the BROWSER can reach, not 127.0.0.1.
SUPABASE_URL=http://10.150.150.130:8010
SUPABASE_PUBLISHABLE_KEY=<PRODUCTION ANON_KEY from Production/backend/.env>
SUPABASE_ANON_KEY=<PRODUCTION ANON_KEY from Production/backend/.env>
# Server-only. Never baked into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=<PRODUCTION SERVICE_ROLE_KEY from Production/backend/.env>
SUPABASE_PROJECT_ID=Production

# ---- Same values for the browser bundle (build time) ---------------------
VITE_SUPABASE_URL=http://10.150.150.130:8010
VITE_SUPABASE_PUBLISHABLE_KEY=<PRODUCTION ANON_KEY>
VITE_SUPABASE_PROJECT_ID=Production

# ---- SAP middleware ------------------------------------------------------
MIDDLEWARE_URL=http://127.0.0.1:3010
# Must match MIDDLEWARE_SHARED_SECRET in the Production middleware .env AND the
# "Proxy Secret / Password" field in Admin -> SAP API Settings.
MIDDLEWARE_SHARED_SECRET=<long random string, different from Quality>
MIDDLEWARE_TIMEOUT_MS=60000
