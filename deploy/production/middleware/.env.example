# ---------------------------------------------------------------------------
# PRODUCTION SAP middleware environment.
# Copy to /data/webapplication/resl_approval/Production/middleware/.env (chmod 600)
# ---------------------------------------------------------------------------

# Port the middleware listens on, inside and outside the container.
PORT=3010

# Shared secret. MUST match:
#   1. MIDDLEWARE_SHARED_SECRET in Production/frontend/.env
#   2. "Proxy Secret / Password" in Admin -> SAP API Settings
# Use a value different from Quality so the environments stay isolated.
MIDDLEWARE_SHARED_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_PROD

# Base URL of the Production app (through nginx on 9091). The middleware calls
#   POST {APP_BASE_URL}/api/public/middleware/config
#   POST {APP_BASE_URL}/api/public/middleware/log
APP_BASE_URL=http://10.150.150.130:9091

# ---- Offline / smoke-test mode ----
MIDDLEWARE_MOCK=0

# ---- Timeouts (milliseconds) ----
SAP_REQUEST_TIMEOUT_MS=30000
SAP_CONNECT_TIMEOUT_MS=60000
SAP_HEADERS_TIMEOUT_MS=60000
SAP_BODY_TIMEOUT_MS=60000

# ---- Optional SAP fallbacks (per-row SAP API Settings always win) ----
SAP_BP_API_URL=
SAP_DMS_API_URL=
SAP_BP_USERNAME=
SAP_BP_PASSWORD=
