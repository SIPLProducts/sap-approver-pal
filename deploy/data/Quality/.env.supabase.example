# ---- Supabase self-host — QUALITY ----
# Reference only. The real file is Quality/supabase/.env, created from the
# upstream supabase/docker/.env.example in step 04, with these values changed.

POSTGRES_PASSWORD=<openssl rand -hex 24>
JWT_SECRET=<openssl rand -hex 32>
ANON_KEY=<JWT signed with JWT_SECRET, role=anon>
SERVICE_ROLE_KEY=<JWT signed with JWT_SECRET, role=service_role>
SECRET_KEY_BASE=<openssl rand -hex 32>
VAULT_ENC_KEY=<openssl rand -hex 16>
LOGFLARE_PUBLIC_ACCESS_TOKEN=<openssl rand -hex 32>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<openssl rand -hex 32>

DASHBOARD_USERNAME=studioadmin
DASHBOARD_PASSWORD=<openssl rand -hex 24>

# Ports — QUALITY
POSTGRES_PORT=5432
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3001

# Public URLs — must match the Nginx hostnames
SITE_URL=https://quality.example.com
API_EXTERNAL_URL=https://api-quality.example.com
SUPABASE_PUBLIC_URL=https://api-quality.example.com
ADDITIONAL_REDIRECT_URLS=https://quality.example.com/**

# Auth policy — this app provisions users, public signup stays off
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
JWT_EXPIRY=3600

# SMTP for password reset / invite mails
SMTP_ADMIN_EMAIL=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp user>
SMTP_PASS=<smtp password>
SMTP_SENDER_NAME=RESL Approvals (Quality)
