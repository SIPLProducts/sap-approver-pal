# ---- SAP middleware — QUALITY ----
# Copy to .env.middleware and fill in.  chmod 600 .env.middleware

PORT=3005

# Same value as MIDDLEWARE_SHARED_SECRET in .env.app and the UI field.
MIDDLEWARE_SHARED_SECRET=CHANGE_ME_LONG_RANDOM_QUALITY

# Your own app hostname (no longer a *.lovable.app URL).
APP_BASE_URL=https://quality.example.com

# 1 = offline smoke test using the SAP_BP_* values below only.
MIDDLEWARE_MOCK=0

# Timeouts (ms). Keep Nginx proxy_read_timeout at or above this.
SAP_REQUEST_TIMEOUT_MS=300000
SAP_CONNECT_TIMEOUT_MS=60000
SAP_HEADERS_TIMEOUT_MS=60000
SAP_BODY_TIMEOUT_MS=60000

# Optional fallbacks. Per-row values in SAP API Settings always win.
SAP_BP_API_URL=
SAP_DMS_API_URL=
SAP_BP_USERNAME=
SAP_BP_PASSWORD=
