# ---- RESL Approval app — QUALITY ----
# Copy to .env.app and fill in.  chmod 600 .env.app

# --- Client-visible: compiled into the browser bundle at BUILD time ---
# Changing any of these requires a rebuild, not just a restart.
VITE_SUPABASE_URL=https://api-quality.example.com
VITE_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY from Quality/supabase/.env>
VITE_SUPABASE_PROJECT_ID=resl-quality

# --- Server-only: read at RUNTIME ---
SUPABASE_URL=https://api-quality.example.com
SUPABASE_PUBLISHABLE_KEY=<ANON_KEY>
SUPABASE_ANON_KEY=<ANON_KEY>
# Bypasses RLS. Never prefix with VITE_, never commit.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Must match MIDDLEWARE_SHARED_SECRET in .env.middleware and the
# "Proxy Secret / Password" field in Admin -> SAP API Settings.
MIDDLEWARE_SHARED_SECRET=CHANGE_ME_LONG_RANDOM_QUALITY

# Web push (docker run --rm node:22-alpine sh -c "npm i -g web-push && web-push generate-vapid-keys")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com

NODE_ENV=production
PORT=3000
