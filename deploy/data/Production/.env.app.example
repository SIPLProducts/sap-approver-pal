# ---- RESL Approval app — PRODUCTION ----
# Copy to .env.app and fill in.  chmod 600 .env.app

# --- Client-visible: compiled into the browser bundle at BUILD time ---
VITE_SUPABASE_URL=https://api.example.com
VITE_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY from Production/supabase/.env>
VITE_SUPABASE_PROJECT_ID=resl-production

# --- Server-only: read at RUNTIME ---
SUPABASE_URL=https://api.example.com
SUPABASE_PUBLISHABLE_KEY=<ANON_KEY>
SUPABASE_ANON_KEY=<ANON_KEY>
# Bypasses RLS. Never prefix with VITE_, never commit.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

MIDDLEWARE_SHARED_SECRET=CHANGE_ME_LONG_RANDOM_PRODUCTION

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com

NODE_ENV=production
PORT=3010
