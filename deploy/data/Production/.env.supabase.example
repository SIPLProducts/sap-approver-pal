# ---- Supabase self-host — PRODUCTION ----
# Reference only. The real file is Production/supabase/.env.
# Every secret here MUST differ from the Quality set.

POSTGRES_PASSWORD=<openssl rand -hex 24>
JWT_SECRET=<openssl rand -hex 32>
ANON_KEY=<JWT signed with JWT_SECRET, role=anon>
SERVICE_ROLE_KEY=<JWT signed with JWT_SECRET, role=service_role>
SECRET_KEY_BASE=<openssl rand -hex 32>
VAULT_ENC_KEY=<openssl rand -hex 16>
LOGFLARE_PUBLIC_ACCESS_TOKEN=<openssl rand -hex 32>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<openssl rand -hex 32>

DASHBOARD_USERNAME=studioadmin
DASHBOARD_PASSWORD=<openssl rand -hex 24>

# Ports — PRODUCTION
POSTGRES_PORT=5433
KONG_HTTP_PORT=8010
KONG_HTTPS_PORT=8453
STUDIO_PORT=3011

SITE_URL=https://app.example.com
API_EXTERNAL_URL=https://api.example.com
SUPABASE_PUBLIC_URL=https://api.example.com
ADDITIONAL_REDIRECT_URLS=https://app.example.com/**

DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
JWT_EXPIRY=3600

SMTP_ADMIN_EMAIL=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp user>
SMTP_PASS=<smtp password>
SMTP_SENDER_NAME=RESL Approvals
