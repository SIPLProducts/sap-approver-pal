# ---- SAP middleware — PRODUCTION ----
# Copy to .env.middleware and fill in.  chmod 600 .env.middleware
# Container listens on 3005; compose publishes it on host port 3006.

PORT=3005

MIDDLEWARE_SHARED_SECRET=CHANGE_ME_LONG_RANDOM_PRODUCTION

APP_BASE_URL=https://app.example.com

MIDDLEWARE_MOCK=0

SAP_REQUEST_TIMEOUT_MS=300000
SAP_CONNECT_TIMEOUT_MS=60000
SAP_HEADERS_TIMEOUT_MS=60000
SAP_BODY_TIMEOUT_MS=60000

SAP_BP_API_URL=
SAP_DMS_API_URL=
SAP_BP_USERNAME=
SAP_BP_PASSWORD=
