# ---- Quality middleware server ----
# Port inside the container. The docker-compose.yml maps host port 3005 to this.
PORT=3005

# Shared secret. MUST match the MIDDLEWARE_SHARED_SECRET secret in Lovable Cloud
# and the "Proxy Secret / Password" field in the Lovable app.
MIDDLEWARE_SHARED_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_QUALITY

# Stable preview URL (latest preview build, no auth gate).
# DO NOT use the id-preview--*.lovable.app host — it is auth-gated and the
# middleware cannot call it.
APP_BASE_URL=https://project--06a5c0be-58b7-41a6-ac2d-e7706e765b64-dev.lovable.app

# ---- Offline / smoke-test mode ----
# Set to 1 to skip the app call and build a config from SAP_BP_* env vars.
MIDDLEWARE_MOCK=0

# ---- Timeouts (milliseconds) ----
SAP_REQUEST_TIMEOUT_MS=30000
SAP_CONNECT_TIMEOUT_MS=60000
SAP_HEADERS_TIMEOUT_MS=60000
SAP_BODY_TIMEOUT_MS=60000

# ---- Optional SAP fallbacks ----
# Used in MOCK_MODE or when the app returns a row without URL/credentials.
# Per-row values from SAP API Settings always win.
SAP_BP_API_URL=
SAP_DMS_API_URL=
SAP_BP_USERNAME=
SAP_BP_PASSWORD=
