# ---------------------------------------------------------------------------
# Supabase self-hosted stack — QUALITY environment
# Copy this file to `.env` and replace every `CHANGE_ME_*` value.
# Then run: chmod 600 .env
#
# This file is pre-configured for the single-host Nginx setup in
# deploy/quality/nginx/resl-approval-quality-single-host.conf.
# ---------------------------------------------------------------------------

############
# Secrets — generate ALL of these before first start
# ---------------------------------------------------------------------------

# Postgres superuser password
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# Symmetric JWT signing secret. Must be at least 32 characters.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# HS256 JWT API keys signed with the JWT_SECRET above.
# Mint them on the server with:
#   JWT_SECRET='<paste>' node -e 'const crypto=require("crypto"); ...'
# See docs/deployment/05-supabase.md for the full script.
ANON_KEY=CHANGE_ME_minted_jwt_role_anon
SERVICE_ROLE_KEY=CHANGE_ME_minted_jwt_role_service_role

# Used by Realtime / Supavisor. Must be >= 64 characters (base64).
SECRET_KEY_BASE=CHANGE_ME_openssl_rand_base64_48

# Used by Supavisor / Vault. Must be exactly 32 hex characters.
VAULT_ENC_KEY=CHANGE_ME_openssl_rand_hex_16

# Used by Realtime for sensitive fields. Must be exactly 16 characters.
REALTIME_DB_ENC_KEY=CHANGE_ME_16_chars

# Used by postgres-meta for encrypting connection strings. Must be >= 32 chars.
PG_META_CRYPTO_KEY=CHANGE_ME_openssl_rand_base64_24

# Logflare tokens. Must be >= 32 characters.
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME_openssl_rand_hex_32
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGE_ME_openssl_rand_hex_32

# Studio login
DASHBOARD_USERNAME=studioadmin
DASHBOARD_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# S3 protocol access for Storage backend
S3_PROTOCOL_ACCESS_KEY_ID=CHANGE_ME_openssl_rand_hex_16
S3_PROTOCOL_ACCESS_KEY_SECRET=CHANGE_ME_openssl_rand_hex_32

# Storage file backend (no external S3 in this deployment)
STORAGE_TENANT_ID=stub
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_16

############
# URLs — must match the Nginx server_name or IP
# ---------------------------------------------------------------------------

# Full public URL used by the app and Studio
SITE_URL=http://10.150.150.130:8081
API_EXTERNAL_URL=http://10.150.150.130:8000/auth/v1
SUPABASE_PUBLIC_URL=http://10.150.150.130:8000
ADDITIONAL_REDIRECT_URLS=http://10.150.150.130:8081/**

############
# Database
# ---------------------------------------------------------------------------

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Supavisor / pooler
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=200
POOLER_TENANT_ID=resl-quality
POOLER_DB_POOL_SIZE=5

############
# Studio
# ---------------------------------------------------------------------------

STUDIO_DEFAULT_ORGANIZATION=RESL
STUDIO_DEFAULT_PROJECT=RESL Approvals Quality
STUDIO_PORT=3000
OPENAI_API_KEY=      # leave empty to disable AI assistant

############
# Auth policy
# ---------------------------------------------------------------------------

DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
JWT_EXPIRY=3600

############
# SMTP for password reset / invite emails
# ---------------------------------------------------------------------------

SMTP_ADMIN_EMAIL=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SENDER_NAME=RESL Approvals (Quality)
MAILER_URLPATHS_INVITE=/login
MAILER_URLPATHS_CONFIRMATION=/login
MAILER_URLPATHS_RECOVERY=/login
MAILER_URLPATHS_EMAIL_CHANGE=/login

############
# Storage
# ---------------------------------------------------------------------------

FILE_SIZE_LIMIT=52428800
STORAGE_BACKEND=file
GLOBAL_S3_BUCKET=stub
REGION=stub

############
# Functions — unused by this app, but required by the stack
# ---------------------------------------------------------------------------

FUNCTIONS_VERIFY_JWT=true

############
# API / PostgREST
# ---------------------------------------------------------------------------

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Logs and Analytics
# ---------------------------------------------------------------------------

DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=      # leave empty unless using external analytics
GOOGLE_PROJECT_NUMBER=  # leave empty unless using external analytics

############
# API gateway (Kong)
# ---------------------------------------------------------------------------

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Leave asymmetric keys empty unless you explicitly enable ES256.
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=

############
# imgproxy
# ---------------------------------------------------------------------------

IMGPROXY_AUTO_WEBP=true
IMGPROXY_ENABLE_WEBP_DETECTION=true

############
# Docker Compose project name — not a secret, but keep it consistent
# ---------------------------------------------------------------------------

COMPOSE_FILE=docker-compose.yml
