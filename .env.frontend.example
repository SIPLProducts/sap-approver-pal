# ---------------------------------------------------------------------------
# Frontend / app-server environment (self-hosted Quality & Production).
#
# Copy this to  <frontend folder>/.env  and fill in the real values.
# `npm run build:selfhost` reads it, bakes the VITE_* values into the browser
# bundle, and writes the server-side values to dist/.env.runtime.
#
# IMPORTANT — two halves, both required:
#   VITE_*  are COMPILED INTO the browser bundle at BUILD time. If they are
#           missing the app loads and immediately shows
#           "Missing Supabase environment variable(s)". Editing .env afterwards
#           cannot fix a built dist/ — you must rebuild.
#   plain   names are read at RUNTIME by the app server (dist/start.mjs).
# ---------------------------------------------------------------------------

PORT=8080
HOST=127.0.0.1
NODE_ENV=production

# ---- Supabase (self-hosted stack, Kong on :8000) --------------------------
# SUPABASE_URL must be the host the BROWSER can reach, not 127.0.0.1.
SUPABASE_URL=http://10.150.150.130:8000
# ANON_KEY from supabase/.env — safe in the browser.
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# SERVICE_ROLE_KEY from supabase/.env — server-only, never baked into the bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Same two values for the browser bundle (build time) -----------------
VITE_SUPABASE_URL=http://10.150.150.130:8000
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- SAP middleware ------------------------------------------------------
MIDDLEWARE_URL=http://127.0.0.1:3002
# Must match MIDDLEWARE_SHARED_SECRET in middleware/.env.
MIDDLEWARE_SHARED_SECRET=
MIDDLEWARE_TIMEOUT_MS=60000
